<%- include('partials/header', { subject: subject }) %>

<div style="text-align: center; margin-bottom: 24px;">
  <span class="badge badge-warning">Security Verification</span>
  <h2 style="font-family: Georgia, serif; font-size: 22px; color: #18181b; margin: 16px 0 8px 0;">Password Reset Code</h2>
  <p style="font-size: 14px; color: #52525b; line-height: 1.5; margin: 0;">
    Hello <%= userName %>, we received a request to reset your password for your <strong>Sai Collection</strong> account.
  </p>
</div>

<!-- Prominent OTP Code Box -->
<div style="background-color: #fdf2f4; border: 2px border #9b1c31; border-radius: 16px; padding: 24px; text-align: center; margin: 24px 0;">
  <div style="font-size: 12px; font-weight: bold; color: #9b1c31; letter-spacing: 1.5px; text-transform: uppercase;">Your Verification OTP</div>
  <div style="font-family: monospace, Courier, monospace; font-size: 38px; font-weight: bold; color: #9b1c31; letter-spacing: 8px; margin: 12px 0;">
    <%= otpCode %>
  </div>
  <div style="font-size: 11px; color: #9f1239; font-weight: 600;">
    ⏱️ Valid for <strong><%= expiresInMinutes || 10 %> minutes</strong> only.
  </div>
</div>

<div style="background-color: #f4f4f5; border-radius: 8px; padding: 14px; font-size: 12px; color: #52525b; line-height: 1.5;">
  <strong>Security Reminder:</strong> If you did not request a password reset, please ignore this email or contact support immediately. Never share your OTP with anyone.
</div>

<%- include('partials/footer', { storefrontUrl: storefrontUrl }) %>
